{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/whatsapp-config/layout,_N_T_/whatsapp-config/page,_N_T_/whatsapp-config"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/whatsapp-config/__PAGE__",
    "/whatsapp-config",
    "/_index",
    "/_head"
  ]
}