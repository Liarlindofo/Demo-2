# ===================================
# 🔐 VARIÁVEIS DE AMBIENTE - SESSÃO
# ===================================

# Stack Auth - Configurações Básicas
NEXT_PUBLIC_STACK_PROJECT_ID=seu-project-id-aqui
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=sua-publishable-key-aqui
STACK_SECRET_SERVER_KEY=sua-secret-key-aqui

# 🆕 Stack Auth - Duração da Sessão
# Nota: Estas variáveis podem não ser suportadas em todas as versões do Stack Auth
# Se não funcionarem, o refresh automático (já implementado) cuidará disso
STACK_SESSION_DURATION=21600          # 6 horas em segundos
STACK_REFRESH_TOKEN_DURATION=2592000  # 30 dias em segundos
STACK_ACCESS_TOKEN_DURATION=21600     # 6 horas em segundos

# 🔧 JWT Customizado (Opcional - Backup)
# Use apenas se o Stack Auth não fornecer controle suficiente
JWT_SECRET=sua-chave-secreta-min-32-caracteres-aqui
JWT_EXPIRATION=21600               # 6 horas em segundos
JWT_REFRESH_EXPIRATION=2592000     # 30 dias em segundos

# ===================================
# 📊 CONVERSÃO DE TEMPO (Referência)
# ===================================
# 1 hora   = 3600 segundos
# 6 horas  = 21600 segundos
# 12 horas = 43200 segundos
# 24 horas = 86400 segundos
# 7 dias   = 604800 segundos
# 30 dias  = 2592000 segundos

# ===================================
# ⚠️ IMPORTANTE
# ===================================
# 1. Adicione estas variáveis no seu arquivo .env.local
# 2. Reinicie o servidor após adicionar: npm run dev
# 3. O refresh automático JÁ ESTÁ IMPLEMENTADO no código
# 4. Ele renova o token a cada 60 minutos automaticamente
# 5. Funciona em conjunto com o auto-save do checklist
