// ── Módulo RH ─────────────────────────────────────────────────────────────────

model RhLoja {
  id                    String                  @id @default(cuid())
  userId                String
  nome                  String
  cnpj                  String?
  endereco              String?
  latitude              Float?
  longitude             Float?
  raioVerificacaoM      Int                     @default(300) @map("raio_verificacao_m")
  fap                   Float                   @default(1.0)
  ativo                 Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  funcionarios          RhFuncionario[]
  quadroIdeal           RhQuadroIdeal?
  snapshots             RhSnapshotCustoMensal[]
  transferenciasOrigem  RhTransferenciaLoja[]   @relation("TransferenciaOrigem")
  transferenciasDestino RhTransferenciaLoja[]   @relation("TransferenciaDestino")
  plrs                  RhPLRTrimestral[]
  tarefaTemplates       TarefaTemplate[]
  tarefasAtribuidas     TarefaAtribuida[]
  tarefaSeries          TarefaSerie[]
  taxas                 RhTaxaLoja[]
  riders                DeliveryRider[]

  @@index([userId])
  @@map("rh_lojas")
}

model RhCargo {
  id            String           @id @default(cuid())
  userId        String
  nome          String
  descricao     String?
  ratPct        Float            @default(2.0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  funcionarios    RhFuncionario[]
  posicoesIdeais  RhPosicaoIdeal[]
  tarefaTemplates TarefaTemplate[]

  @@index([userId])
  @@map("rh_cargos")
}

model RhFuncionario {
  id                    String                   @id @default(cuid())
  userId                String
  nome                  String
  cpf                   String?
  email                 String?
  telefone              String?
  dataNascimento        DateTime?
  dataAdmissao          DateTime?
  cargoId               String?
  lojaId                String?
  // Composição salarial
  salarioBase             Float     @default(0)
  valorAlimentacao        Float                    @default(0)
  valorVT                 Float                    @default(0)
  cargoResponsabilidade   Boolean                  @default(false)
  bonificacaoAssiduidade  Float                    @default(0)
  escala                String
  turno                 String
  horarioEntrada        String                   @default("08:00")
  horarioSaida          String                   @default("17:00")
  /** Horário do resumo diário de tarefas no WhatsApp (HH:mm, BRT). */
  horarioDigest         String                   @default("08:00")
  diasFolga             Json                     @default("[]")
  domingoFolga          String?
  observacoes           String?
  ativo                 Boolean                  @default(true)
  // Período de experiência (calculado automaticamente)
  dataInicioExperiencia DateTime?
  dataFimExperiencia1   DateTime?
  dataFimExperiencia2   DateTime?
  // Férias
  dataInicioFerias      DateTime?
  dataGozoFerias        DateTime?
  statusFerias          String?                  @default("a_gozar")
  diasFeriasGozados     Int?                     @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cargo                 RhCargo?                 @relation(fields: [cargoId], references: [id])
  loja                  RhLoja?                  @relation(fields: [lojaId], references: [id])
  historico             RhHistoricoFuncionario[]
  documentos            RhDocumentoFuncionario[]
  ocorrencias           RhOcorrencia[]
  transferencias        RhTransferenciaLoja[]
  bonificacoesTrimestrais RhBonificacaoTrimestral[]
  bonificacoesAssiduidade RhBonificacaoAssiduidade[]
  plrPagamentos           RhPLRPagamento[]
  tarefasAtribuidas       TarefaAtribuida[]
  tarefaSeries            TarefaSerie[]

  @@index([userId, cpf])
  @@index([userId])
  @@index([lojaId])
  @@index([cargoId])
  @@map("rh_funcionarios")
}

model RhBonificacaoTrimestral {
  id            String        @id @default(cuid())
  funcionarioId String
  valor         Float
  trimestre     Int
  ano           Int
  dataPagamento DateTime
  motivo        String?
  registradoPor String
  ativo         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  funcionario   RhFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, trimestre, ano])
  @@index([funcionarioId])
  @@map("rh_bonificacoes_trimestrais")
}

model RhBonificacaoAssiduidade {
  id            String        @id @default(cuid())
  funcionarioId String
  mes           Int
  ano           Int
  valorDireito  Float         @default(200)
  recebeu       Boolean       @default(true)
  motivo        String?
  registradoPor String?
  viaIA         Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  funcionario   RhFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, mes, ano])
  @@index([funcionarioId])
  @@map("rh_bonificacoes_assiduidade")
}

model RhPLRTrimestral {
  id                  String           @id @default(cuid())
  lojaId              String
  trimestre           Int
  ano                 Int
  valorTotal          Float
  valorPorFuncionario Float
  metaBatida          Boolean          @default(true)
  observacao          String?
  registradoPor       String?
  viaIA               Boolean          @default(false)
  createdAt           DateTime         @default(now())
  loja                RhLoja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pagamentos          RhPLRPagamento[]

  @@unique([lojaId, trimestre, ano])
  @@index([lojaId])
  @@map("rh_plr_trimestrais")
}

model RhPLRPagamento {
  id            String          @id @default(cuid())
  plrId         String
  funcionarioId String
  valor         Float
  createdAt     DateTime        @default(now())
  plr           RhPLRTrimestral @relation(fields: [plrId], references: [id], onDelete: Cascade)
  funcionario   RhFuncionario   @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([plrId, funcionarioId])
  @@index([funcionarioId])
  @@map("rh_plr_pagamentos")
}

model RhHistoricoFuncionario {
  id            String        @id @default(cuid())
  userId        String
  funcionarioId String
  campo         String
  valorAnterior String
  valorNovo     String
  alteradoPor   String
  motivo        String?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  funcionario   RhFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([userId])
  @@map("rh_historico_funcionarios")
}

model RhQuadroIdeal {
  id        String         @id @default(cuid())
  userId    String
  lojaId    String         @unique
  nome      String?
  ativo     Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  loja      RhLoja         @relation(fields: [lojaId], references: [id])
  setores   RhSetorIdeal[]

  @@index([userId])
  @@map("rh_quadros_ideais")
}

model RhSetorIdeal {
  id            String           @id @default(cuid())
  quadroIdealId String
  nome          String
  descricao     String?
  ordem         Int              @default(0)
  ativo         Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  quadroIdeal   RhQuadroIdeal    @relation(fields: [quadroIdealId], references: [id], onDelete: Cascade)
  posicoes      RhPosicaoIdeal[]

  @@index([quadroIdealId])
  @@map("rh_setores_ideais")
}

model RhPosicaoIdeal {
  id              String       @id @default(cuid())
  setorId         String
  cargoId         String
  turno           String
  quantidadeIdeal Int
  observacoes     String?
  ativo           Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  setor           RhSetorIdeal @relation(fields: [setorId], references: [id], onDelete: Cascade)
  cargo           RhCargo      @relation(fields: [cargoId], references: [id])

  @@index([setorId])
  @@index([cargoId])
  @@map("rh_posicoes_ideais")
}

model RhIaConversa {
  id        String         @id @default(cuid())
  userId    String
  titulo    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mensagens RhIaMensagem[]

  @@index([userId])
  @@map("rh_ia_conversas")
}

model RhIaMensagem {
  id         String       @id @default(cuid())
  conversaId String
  role       String
  content    String       @db.Text
  citacoes   Json         @default("[]")
  isError    Boolean      @default(false)
  createdAt  DateTime     @default(now())
  conversa   RhIaConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("rh_ia_mensagens")
}

model RhDocumentoFuncionario {
  id             String        @id @default(cuid())
  funcionarioId  String
  userId         String
  tipo           String
  nome           String
  url            String
  tamanhoBytes   Int?
  dataVencimento DateTime?
  mesReferencia  Int?
  anoReferencia  Int?
  observacoes    String?
  ativo          Boolean       @default(true)
  uploadadoPor   String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  funcionario    RhFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([userId])
  @@map("rh_documentos_funcionarios")
}

model RhOcorrencia {
  id            String        @id @default(cuid())
  funcionarioId String
  userId        String
  tipo          String
  data          DateTime
  descricao     String        @db.Text
  gravidade     String?
  testemunhas   String?
  providencia   String?
  cidAfastamento String?
  dataInicioAfastamento DateTime?
  dataFimAfastamento    DateTime?
  registradoPor String
  ativo         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  funcionario   RhFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([userId])
  @@map("rh_ocorrencias")
}

model RhSnapshotCustoMensal {
  id                String   @id @default(cuid())
  lojaId            String
  userId            String
  mes               Int
  ano               Int
  totalFuncionarios Int
  totalSalarioBruto Float
  totalEncargos     Float
  totalCustoReal    Float
  custoAnualizado   Float
  geradoEm          DateTime @default(now())
  loja              RhLoja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lojaId, mes, ano, userId])
  @@index([lojaId])
  @@index([userId])
  @@map("rh_snapshots_custo_mensal")
}

model RhTransferenciaLoja {
  id                String        @id @default(cuid())
  funcionarioId     String
  lojaOrigemId      String
  lojaDestinoId     String
  userId            String
  dataTransferencia DateTime
  motivo            String?
  aprovadoPor       String?
  createdAt         DateTime      @default(now())
  funcionario       RhFuncionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  lojaOrigem        RhLoja        @relation("TransferenciaOrigem", fields: [lojaOrigemId], references: [id])
  lojaDestino       RhLoja        @relation("TransferenciaDestino", fields: [lojaDestinoId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([userId])
  @@map("rh_transferencias_lojas")
}

model RhTaxaLoja {
  id               String   @id @default(cuid())
  userId           String
  lojaId           String
  nome             String
  valorDiaria      Float
  diasPorMes       Int      @default(1)
  quantidadeIdeal  Int      @default(1)
  observacoes      String?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loja             RhLoja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lojaId])
  @@map("rh_taxas_loja")
}

// ─── Módulo Motoboys ────────────────────────────────────────────────────────

model DeliveryRider {
  id               String                 @id @default(cuid())
  userId           String
  lojaId           String
  name             String
  cnpj             String
  email            String
  phone            String?
  status           String                 @default("pending_setup")
  passwordHash     String?
  inviteToken      String?                @unique
  inviteTokenExpiresAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  loja             RhLoja                 @relation(fields: [lojaId], references: [id])
  paymentPeriods   RiderPaymentPeriod[]

  @@unique([userId, email])
  @@unique([userId, cnpj])
  @@index([userId])
  @@index([lojaId])
  @@map("delivery_riders")
}

model RiderPaymentPeriod {
  id              String           @id @default(cuid())
  userId          String
  riderId         String
  lojaId          String
  periodLabel     String
  periodStart     DateTime
  periodEnd       DateTime
  deliveryCount   Int              @default(0)
  amountCents     Int              @default(0)   // valor total bruto (já inclui diárias)
  dailyRateCents  Int              @default(0)   // valor por entrega/diária (informativo)
  discountCents   Int              @default(0)   // desconto por consumo na loja
  discountNotes   String?                        // detalhes do que foi consumido
  summary         String?
  status          String           @default("pending_documents")
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rider           DeliveryRider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  documents       RiderDocument[]

  @@index([riderId])
  @@index([userId])
  @@map("rider_payment_periods")
}

model RiderDocument {
  id            String             @id @default(cuid())
  userId        String
  periodId      String
  riderId       String
  documentType  String
  fileName      String
  storagePath   String
  uploadedAt    DateTime           @default(now())
  status        String             @default("pending")
  reviewedBy    String?
  reviewedAt    DateTime?
  period        RiderPaymentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([riderId])
  @@index([userId])
  @@map("rider_documents")
}

// ─── Sistema de equipe RH ────────────────────────────────────────────────────

// Membros da equipe de RH convidados pelo Admin (owner) para acessar seus dados
model RhTeamMember {
  id           String         @id @default(cuid())
  tenantUserId String         // User.id do dono dos dados (Admin)
  stackUserId  String?        // Stack Auth id do membro (null até aceitar convite)
  email        String
  displayName  String?
  isActive     Boolean        @default(true)
  invitedBy    String         // Stack Auth id de quem convidou
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenantUser   User           @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  permissions  RhPermission[]

  @@unique([tenantUserId, email])
  @@index([stackUserId])
  @@index([tenantUserId])
  @@map("rh_team_members")
}

// Permissões granulares por membro da equipe
model RhPermission {
  id         String       @id @default(cuid())
  memberId   String
  permission String
  grantedBy  String       // Stack Auth id de quem concedeu
  grantedAt  DateTime     @default(now())

  member     RhTeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, permission])
  @@index([memberId])
  @@map("rh_permissions")
}

// Permissões de ferramentas para usuários do sistema (stack_users)
model UserToolPermission {
  id          String     @id @default(cuid())
  stackUserId String     @map("stack_user_id")
  tool        String     @db.VarChar(50) // 'etiquetagem', 'checklist', 'cmv', 'analytics', etc.
  isEnabled   Boolean    @default(true) @map("is_enabled")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  stackUser   StackUser  @relation(fields: [stackUserId], references: [id], onDelete: Cascade)

  @@unique([stackUserId, tool])
  @@index([stackUserId])
  @@index([tool])
  @@index([isEnabled])
  @@map("user_tool_permissions")
}

// Configurações globais do sistema (chave-valor)
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String?
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// ── MÓDULO TAREFAS ─────────────────────────────────────────────────────────

enum StatusTarefa {
  AGENDADA
  ENVIADA
  AGUARDANDO_EVIDENCIA
  CONCLUIDA
  CONCLUIDA_COM_ATRASO
  NAO_CONCLUIDA
}

enum TipoEvidencia {
  FOTO
  CONFIRMACAO_TEXTO
  LOCALIZACAO
  ARQUIVO
}

/// Template reutilizável de tarefa operacional
model TarefaTemplate {
  id                    String   @id @default(cuid())
  userId                String   // tenant owner
  titulo                String
  descricao             String   @db.Text
  exigeFoto             Boolean  @default(false)
  exigeConfirmacaoTexto Boolean  @default(false)
  exigeLocalizacao      Boolean  @default(false)
  exigeArquivo          Boolean  @default(false)
  /// Metadados para validação por visão: { objeto_esperado, extrair, faixa_ok: { min, max }, unidade }
  validacaoIA           Json?
  /// Dias em que a tarefa deve ser feita (0=Dom … 6=Sáb). Usado como padrão na atribuição.
  diasSemana            Int[]    @default([])
  /// Horário limite padrão (HH:mm, BRT) ao atribuir este template.
  horarioPadrao         String   @default("08:00")
  lojaId                String?  // null = global
  cargoId               String?  // null = todos os cargos
  ativo                 Boolean  @default(true)
  criadoPor             String   // Stack Auth userId
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loja        RhLoja?            @relation(fields: [lojaId], references: [id])
  cargo       RhCargo?           @relation(fields: [cargoId], references: [id])
  atribuicoes TarefaAtribuida[]
  grupoItens  TarefaGrupoItem[]
  series      TarefaSerie[]

  @@index([userId])
  @@index([lojaId])
  @@index([userId, ativo])
  @@map("tarefa_templates")
}

/// Pacote de templates para atribuir de uma vez (ex.: "Tarefas gerentes").
model TarefaGrupo {
  id          String   @id @default(cuid())
  userId      String
  nome        String
  descricao   String?  @db.Text
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  itens TarefaGrupoItem[]

  @@index([userId, ativo])
  @@map("tarefa_grupos")
}

model TarefaGrupoItem {
  id         String @id @default(cuid())
  grupoId    String
  templateId String
  ordem      Int    @default(0)

  grupo    TarefaGrupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  template TarefaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([grupoId, templateId])
  @@index([templateId])
  @@map("tarefa_grupo_itens")
}

/// Recorrência aberta (sem data de término). O cron renova o horizonte de 90 dias.
model TarefaSerie {
  id            String   @id @default(cuid())
  userId        String
  templateId    String
  funcionarioId String
  lojaId        String
  horario       String
  tipo          String
  diasSemana    Int[]    @default([])
  mensalModo    String?
  diaDoMes      Int?
  nth           Int?
  weekday       Int?
  renovarAuto   Boolean  @default(true)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template    TarefaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  funcionario RhFuncionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  loja        RhLoja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  atribuicoes TarefaAtribuida[]

  @@unique([templateId, funcionarioId, lojaId])
  @@index([userId, ativo])
  @@map("tarefa_series")
}

/// Instância de tarefa atribuída a um funcionário em data/hora específica
model TarefaAtribuida {
  id            String       @id @default(cuid())
  userId        String       // tenant owner
  templateId    String
  funcionarioId String
  lojaId        String
  serieId       String?
  dataAgendada  DateTime     // data + horário limite de conclusão
  status        StatusTarefa @default(AGENDADA)
  enviadaEm     DateTime?
  concluidaEm   DateTime?
  minutosAtraso Int          @default(0)
  /// true quando a IA detectar divergência entre texto e imagem
  emRevisaoAdm  Boolean      @default(false)
  revisadaPor   String?
  revisadaEm    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template    TarefaTemplate    @relation(fields: [templateId], references: [id])
  funcionario RhFuncionario     @relation(fields: [funcionarioId], references: [id])
  loja        RhLoja            @relation(fields: [lojaId], references: [id])
  serie       TarefaSerie?      @relation(fields: [serieId], references: [id], onDelete: SetNull)
  evidencias  TarefaEvidencia[]

  @@index([funcionarioId, dataAgendada])
  @@index([lojaId, dataAgendada])
  @@index([userId])
  @@index([userId, status])
  @@index([serieId])
  @@map("tarefa_atribuidas")
}

/// Sessão de conversa de tarefa por telefone (máquina de estados do bot WhatsApp).
/// Persiste reinicializações do PM2; uma sessão por tarefa/telefone.
model SessaoTarefa {
  id                  String   @id @default(cuid())
  /// ID da TarefaAtribuida correspondente (sem FK explícita para desacoplar do fluxo Next.js)
  tarefaId            String
  /// Telefone do funcionário em dígitos puros, ex: "5511999999999"
  telefone            String
  /// LID do WhatsApp capturado no momento do envio (só dígitos, sem "@lid")
  lid                 String?  @db.VarChar(32)
  /// Array dos tipos de evidência exigidos, ex: ["FOTO","CONFIRMACAO_TEXTO"]
  evidenciasExigidas  Json
  /// Array dos tipos de evidência já recebidos e registrados
  evidenciasRecebidas Json     @default("[]")
  /// AGUARDANDO | CONCLUIDA | EXPIRADA
  estado              String   @default("AGUARDANDO")
  /// Descrição da tarefa (descricao do template) — usada no prompt de validação por IA
  descricaoTarefa     String?  @db.Text
  /// Config de validação por IA do template (objeto_esperado, extrair, min, max, unidade)
  validacaoIA         Json?
  /// Quantas vezes pedimos nova foto por baixa qualidade (máx 2 pedidos antes de aceitar)
  tentativasFoto      Int      @default(0)
  /// Momento em que o bot enviou a mensagem de cobrança
  enviadaEm           DateTime
  criadaEm            DateTime @default(now())
  atualizadaEm        DateTime @updatedAt

  @@index([telefone, estado])
  @@index([lid, estado])
  @@index([estado, criadaEm])
  @@map("sessoes_tarefa")
}

/// Evidência recebida para uma tarefa atribuída
model TarefaEvidencia {
  id                String        @id @default(cuid())
  tarefaAtribuidaId String
  tipo              TipoEvidencia
  conteudoTexto     String?       @db.Text
  urlArquivo        String?
  latitude          Float?
  longitude         Float?
  /// Resposta estruturada da LLM: { objeto_identificado, corresponde_ao_esperado, valor_lido, legivel, confianca, observacao, divergencia }
  analiseIA         Json?
  recebidaEm        DateTime      @default(now())

  tarefaAtribuida TarefaAtribuida @relation(fields: [tarefaAtribuidaId], references: [id], onDelete: Cascade)

  @@index([tarefaAtribuidaId])
  @@map("tarefa_evidencias")
}

// ─────────────────────────────────────────────────────────────────────────────
// Central de Relatórios
// ─────────────────────────────────────────────────────────────────────────────

enum ReportFonte {
  SAIPOS_DASHBOARD
}

enum ReportEscopoLoja {
  POR_LOJA
  CONSOLIDADO
  AMBOS
}

enum ReportExecucaoStatus {
  SUCESSO
  FALHA
}

/// Definição de um relatório automático agendado
model ReportDefinition {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome            String
  fonte           ReportFonte
  /// Horário de disparo no formato "HH:mm", ex: "23:30"
  horario         String
  escopoLoja      ReportEscopoLoja
  /// ID do grupo ou contato no WPPConnect para onde enviar o relatório
  destinoWhatsapp String
  /// Slot da sessão WhatsApp que envia este relatório (independente do destino)
  sessionSlot     Int?
  ativo           Boolean          @default(true)

  campos    ReportField[]
  execucoes ReportExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([ativo, horario])
  @@map("report_definitions")
}

/// Campo selecionado para um relatório
model ReportField {
  id                 String           @id @default(cuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  /// Referencia SaiposFieldCatalog.key
  campoKey           String
  ordem              Int

  @@unique([reportDefinitionId, campoKey])
  @@index([reportDefinitionId])
  @@map("report_fields")
}

/// Catálogo global de campos disponíveis no painel Saipos
model SaiposFieldCatalog {
  key   String @id
  label String
  /// Grupo para organizar o checklist: "geral" | "cupons" | "ticket_medio" | "canal"
  grupo String
  ordem Int    @default(0)

  @@map("saipos_field_catalog")
}

/// Log de cada execução de um relatório agendado
model ReportExecution {
  id                 String               @id @default(cuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition     @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  status             ReportExecucaoStatus
  /// Dados extraídos do Saipos, para auditoria
  payload            Json?
  erro               String?
  executadoEm        DateTime             @default(now())

  @@index([reportDefinitionId, executadoEm])
  @@map("report_executions")
}

/// API key de serviço para autenticação máquina-a-máquina (ex: n8n, VPS)
/// O campo key armazena o HASH SHA-256 — nunca a key em texto puro
model ServiceApiKey {
  id        String   @id @default(cuid())
  /// SHA-256 da key gerada — nunca armazenar texto puro
  key       String   @unique
  nome      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("service_api_keys")
}

/// Execução mensal de revisão de reclamações por IA (um run por tenant/período).
model ComplaintReviewRun {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  /// "EM_ANDAMENTO" (mês aberto, cron iFood) | "PROCESSANDO" | "CONCLUIDO" | "ERRO"
  status           String
  totalConversas   Int?
  conversasProcessadas Int             @default(0)
  totalReclamacoes Int?
  /// contactIds ainda não classificados neste run (retomada).
  pendingContactIds  String[]          @default([])
  /// contactIds já classificados (com ou sem reclamação).
  processedContactIds String[]         @default([])
  /// Lock de batch; se ficar velho, outro tick pode retomar.
  batchLockAt      DateTime?
  /// Token interno para encadear ticks sem reenviar a API key.
  jobToken         String?
  erro             String?
  /// Path interno no bucket privado atas-reclamacoes (nunca URL pública).
  ataStoragePath   String?
  executadoEm      DateTime             @default(now())
  complaints       Complaint[]
  comparison       ComplaintComparison?

  @@index([userId, executadoEm])
  @@index([userId, periodStart, status])
  @@map("complaint_review_runs")
}

/// Grupo WhatsApp (por loja) onde atendentes registram reclamações iFood.
model IFoodComplaintGroup {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JID completo do grupo, ex: "120363...@g.us"
  groupWhatsAppId String
  lojaSlug        String
  lojaNome        String
  /// Sessão WhatsApp que é membro deste grupo
  sessionSlot     Int
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([userId, groupWhatsAppId])
  @@index([userId, sessionSlot, ativo])
  @@map("ifood_complaint_groups")
}

/// Reclamação detectada pela IA em uma conversa (contactId) de um ComplaintReviewRun.
model Complaint {
  id                  String             @id @default(cuid())
  reviewRunId         String
  reviewRun           ComplaintReviewRun @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId           String
  contactName         String?
  resumo              String             @db.Text
  dataOcorrencia      DateTime
  /// IDs de WhatsAppMessage usados como evidência
  evidenciaMessageIds String[]
  /// Número do pedido citado pelo cliente na conversa (nunca inventado).
  numeroPedido        String?
  /// Slot da sessão que capturou a mensagem
  sessionSlot         Int                @default(1)
  /// "CLIENTE" | "GRUPO_IFOOD"
  origem              String             @default("CLIENTE")
  /// lojaSlug/lojaNome quando origem=GRUPO_IFOOD
  lojaGrupo           String?
  /// Vany (ou humano) revisa e confirma depois
  confirmadoPorHumano Boolean            @default(false)
  createdAt           DateTime           @default(now())

  @@index([reviewRunId])
  @@index([userId, dataOcorrencia])
  @@index([userId, contactId])
  @@index([userId, origem])
  @@map("complaints")
}

/// Comparação do run atual com o mês imediatamente anterior (para ata).
model ComplaintComparison {
  id            String             @id @default(cuid())
  reviewRunId   String             @unique
  reviewRun     ComplaintReviewRun @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  /// null se for o primeiro mês com dado (sem comparação possível)
  previousRunId String?
  /// temas/clientes que reclamaram nos dois meses
  recorrentes   Json
  /// reclamações desse mês que não existiam no mês anterior
  novos         Json
  /// temas do mês passado que sumiram este mês
  resolvidos    Json
  /// parágrafo em linguagem natural pra colar na ata
  resumoTexto   String             @db.Text
  createdAt     DateTime           @default(now())

  @@map("complaint_comparisons")
}
