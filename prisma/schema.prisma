generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StackUser {
  id                   String        @id @default(uuid())
  primaryEmail         String?       @unique
  displayName          String?
  profileImageUrl      String?
  primaryEmailVerified DateTime?
  lastActiveAt         DateTime?
  userId               String?       @unique
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User?         @relation("StackUserUser", fields: [userId], references: [id], onDelete: Cascade)
  primaryForUser       User?         @relation("UserStackUser")
  whatsappBots         WhatsAppBot[]
  toolPermissions      UserToolPermission[]

  @@index([isActive])
  @@map("stack_users")
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  username     String?       @unique
  password     String?
  fullName     String?
  cnpj         String?
  birthDate    DateTime?
  isAdmin      Boolean       @default(false)
  stackUserId  String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  name         String?
  stackUserRef StackUser?    @relation("StackUserUser")
  stackUser    StackUser?    @relation("UserStackUser", fields: [stackUserId], references: [id])
  stores       Store[]
  apis         UserAPI[]
  botSettings  BotSettings?
  evaluations  Evaluation[]
  checklistDrafts ChecklistDraft[]
  etiquetagemUnidades EtiquetagemUnidade[]
  etiquetagemProdutos EtiquetagemProduto[]
  etiquetagemNomes     EtiquetagemNomeResponsavel[]
  etiquetagemEtiquetas EtiquetagemEtiqueta[]
  cmvStoreData         CmvStoreData[]
  estoqueContagens     EstoqueContagem[]
  ifoodConnections     IfoodConnection[]

  @@map("users")
}

model UserAPI {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String
  apiKey     String
  baseUrl    String?
  storeId    String
  status     String       @default("disconnected")
  isSyncing  Boolean      @default(false)
  enabled    Boolean      @default(true)
  lastTest   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  salesDaily SalesDaily[]
  syncRuns   SyncRun[]

  @@index([userId])
  @@index([storeId])
  @@index([enabled])
  @@map("user_apis")
}

model Store {
  id                        String        @id @default(cuid())
  name                      String
  address                   String?
  phone                     String?
  cnpj                      String?
  managerName               String?       @map("manager_name")
  abbreviation              String?
  displayOrder              Int?          @default(0) @map("display_order")
  isActive                  Boolean       @default(true)
  lastOvenMaintenance       DateTime?     @map("last_oven_maintenance")
  lastRefrigeratorMaintenance DateTime?   @map("last_refrigerator_maintenance")
  lastPestControl           DateTime?     @map("last_pest_control")
  userId                    String
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations               Evaluation[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([userId])
  @@index([displayOrder])
  @@map("stores")
}

model SalesDaily {
  id              String   @id @default(cuid())
  apiId           String
  storeId         String
  date            DateTime
  totalOrders     Int
  totalSales      Float
  uniqueCustomers Int      @default(0)
  channels        Json?
  createdAt       DateTime @default(now())
  api             UserAPI  @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@unique([apiId, date], name: "sales_daily_api_date_unique")
  @@index([apiId, date])
  @@index([storeId])
  @@map("sales_daily")
}

model Sale {
  id          String   @id @default(cuid())
  userId      String
  storeId     String
  externalId  String
  saleDateUtc DateTime
  totalAmount Float?
  rawJson     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([storeId, externalId], name: "storeId_externalId")
  @@index([storeId])
  @@index([userId])
  @@map("sales")
}

model SalesRawPage {
  id        String   @id @default(cuid())
  syncRunId String
  pageIndex Int
  payload   Json?
  createdAt DateTime @default(now())
  run       SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@map("sales_raw_pages")
}

model SyncRun {
  id               String         @id @default(cuid())
  userApiId        String
  storeId          String
  status           String
  startPeriod      DateTime
  endPeriod        DateTime
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  lastUrl          String?
  totalRequests    Int            @default(0)
  totalRecordsRaw  Int            @default(0)
  totalAfterFilter Int            @default(0)
  syncedCount      Int            @default(0)
  errorsCount      Int            @default(0)
  rawPages         SalesRawPage[]
  errors           SyncError[]
  api              UserAPI        @relation(fields: [userApiId], references: [id], onDelete: Cascade)

  @@index([userApiId])
  @@index([status])
  @@map("sync_runs")
}

model SyncError {
  id             String   @id @default(cuid())
  syncRunId      String
  run            SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  message        String
  payloadPreview String?
  createdAt      DateTime @default(now())

  @@index([syncRunId])
  @@map("sync_errors")
}

model WhatsAppBot {
  id              String     @id @default(cuid())
  userId          String
  stackUser       StackUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot            Int
  status          String?    // Status da sessão (ex: "CONNECTED", "CONNECTING", "QRCODE", etc.)
  isConnected     Boolean    @default(false)
  connectedNumber String?
  sessionJson     Json?
  qrCode          String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, slot])
  @@index([userId])
  @@index([isConnected])
  @@index([status])
  @@map("whatsapp_bots")
}

model BotSettings {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botName       String?  @default("Assistente")
  storeType     String?  @default("restaurant")
  contextLimit  Int      @default(10)
  lineLimit     Int      @default(5)
  basePrompt    String?  @db.Text
  forbidden     String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@map("bot_settings")
}

// Platefull.Check Models
model Evaluation {
  id                    String       @id @default(cuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId               String?
  store                 Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName             String
  supervisorName        String       @map("supervisor_name")
  evaluationDate        DateTime     @map("evaluation_date")
  totalScore            Float        @map("total_score")
  maxTotalScore         Float        @map("max_total_score")
  status                String       @default("completed")
  maintenanceList       String?      @db.Text @map("maintenance_list")
  improvementSuggestions String?     @db.Text @map("improvement_suggestions")
  topicScores           TopicScore[]
  itemScores            ItemScore[]
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([storeId])
  @@index([evaluationDate])
  @@map("evaluations")
}

model TopicScore {
  id            String       @id @default(cuid())
  evaluationId  String       @map("evaluation_id")
  evaluation    Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  topicName     String       @map("topic_name")
  topicScore    Float        @map("topic_score")
  maxScore      Float?       @map("max_score")
  observations  String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([evaluationId])
  @@map("topic_scores")
}

model ItemScore {
  id            String       @id @default(cuid())
  evaluationId  String       @map("evaluation_id")
  evaluation    Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  topicName     String       @map("topic_name")
  itemName      String       @map("item_name")
  itemScore     Float        @map("item_score")
  maxScore      Float        @map("max_score")
  status        String       // 'DE ACORDO', 'PARCIAL', 'FORA DO PADRÃO'
  observations  String?       @db.Text
  photoUrls     Json?        @map("photo_urls")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([evaluationId])
  @@map("item_scores")
}

// Platefull.Check - Checklist Drafts (Auto-save)
model ChecklistDraft {
  id                          String   @id @default(cuid())
  userId                      String
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Dados básicos do checklist
  storeId                     String?  @map("store_id")
  storeName                   String   @map("store_name")
  supervisorName              String   @map("supervisor_name")
  evaluationDate              String   @map("evaluation_date")
  
  // Dados do checklist completo (JSON)
  checklistData               Json     @map("checklist_data")
  
  // Metadados para estatísticas
  totalItems                  Int      @default(0) @map("total_items")
  totalPhotos                 Int      @default(0) @map("total_photos")
  totalComments               Int      @default(0) @map("total_comments")
  
  // Controle de versão e limpeza
  lastSaved                   DateTime @default(now()) @map("last_saved")
  createdAt                   DateTime @default(now()) @map("created_at")
  expiresAt                   DateTime @map("expires_at")
  
  @@index([userId])
  @@index([expiresAt])
  @@index([lastSaved])
  @@index([userId, storeId])
  @@map("checklist_drafts")
}

// Platefull.Label - Etiquetagem Models
model EtiquetagemUnidade {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomeExibicao    String   @map("nome_exibicao")
  cnpj            String
  cnpjFormatado   String   @map("cnpj_formatado")
  cidade          String
  codigoInterno   String   @map("codigo_interno")
  isAtivo         Int      @default(1) @map("is_ativo")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  etiquetas       EtiquetagemEtiqueta[]
  nomes           EtiquetagemNomeResponsavel[]

  @@index([userId])
  @@index([isAtivo])
  @@map("etiquetagem_unidades")
}

model EtiquetagemCategoria {
  id                        String   @id @default(cuid())
  nome                      String
  temperaturaArmazenamento  String   @map("temperatura_armazenamento")
  validadeDescongelado      Int?     @map("validade_descongelado")
  validadeResfriado         Int?     @map("validade_resfriado")
  validadePreparado         Int?     @map("validade_preparado")
  validadePorcionado        Int?     @map("validade_porcionado")
  validadeCongeladoMedio    Int?     @map("validade_congelado_medio")
  validadeCongeladoProfundo Int?     @map("validade_congelado_profundo")
  isAtivo                   Int      @default(1) @map("is_ativo")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  produtos                  EtiquetagemProduto[]

  @@index([isAtivo])
  @@map("etiquetagem_categorias")
}

model EtiquetagemProcesso {
  id                  String   @id @default(cuid())
  nome                String
  isRequerRefrigeracao Int      @default(0) @map("is_requer_refrigeracao")
  isAtivo             Int      @default(1) @map("is_ativo")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  etiquetas           EtiquetagemEtiqueta[]

  @@index([isAtivo])
  @@map("etiquetagem_processos")
}

model EtiquetagemProduto {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                    String
  categoriaId             String?  @map("categoria_id")
  categoria               EtiquetagemCategoria? @relation(fields: [categoriaId], references: [id])
  pesoPadrao              Float?   @map("peso_padrao")
  unidadeMedida           String?  @map("unidade_medida")
  marcaFornecedor         String?  @map("marca_fornecedor")
  tipoArmazenamentoPadrao String?  @map("tipo_armazenamento_padrao")
  isAtivo                 Int      @default(1) @map("is_ativo")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  etiquetas               EtiquetagemEtiqueta[]

  @@index([userId])
  @@index([categoriaId])
  @@index([isAtivo])
  @@map("etiquetagem_produtos")
}

model EtiquetagemNomeResponsavel {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unidadeId         String   @map("unidade_id")
  unidade           EtiquetagemUnidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  nomeCompleto      String   @map("nome_completo")
  primeiraUtilizacao DateTime @map("primeira_utilizacao")
  ultimaUtilizacao  DateTime @map("ultima_utilizacao")
  totalUsos         Int      @default(0) @map("total_usos")
  isAtivo           Int      @default(1) @map("is_ativo")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([unidadeId])
  @@index([isAtivo])
  @@map("etiquetagem_nomes_responsaveis")
}

model EtiquetagemEtiqueta {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  produtoId               String   @map("produto_id")
  produto                 EtiquetagemProduto @relation(fields: [produtoId], references: [id])
  unidadeId               String   @map("unidade_id")
  unidade                 EtiquetagemUnidade @relation(fields: [unidadeId], references: [id])
  processoId              String   @map("processo_id")
  processo                EtiquetagemProcesso @relation(fields: [processoId], references: [id])
  dataValidadeOriginal    DateTime? @map("data_validade_original")
  dataHoraManipulacao     DateTime @map("data_hora_manipulacao")
  dataHoraValidade        DateTime @map("data_hora_validade")
  pesoQuantidade          Float    @map("peso_quantidade")
  unidadeMedida           String   @map("unidade_medida")
  responsavelNome         String   @map("responsavel_nome")
  responsavelId           String?  @map("responsavel_id")
  temperaturaArmazenamento String  @map("temperatura_armazenamento")
  codigoEtiqueta           String  @map("codigo_etiqueta")
  marcaFornecedor          String? @map("marca_fornecedor")
  periodoDias              Int?    @map("periodo_dias")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([produtoId])
  @@index([unidadeId])
  @@index([createdAt])
  @@map("etiquetagem_etiquetas")
}

// ============================================
// PAINEL ADMINISTRATIVO - CALENZA ADM
// ============================================

model AdminUser {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String   @map("password_hash")
  name                  String
  role                  String   @default("user") // super_admin, admin, user
  isActive              Boolean  @default(true) @map("is_active")
  clientId              String?  @map("client_id")
  lastLogin             DateTime? @map("last_login")
  passwordResetToken    String?  @map("password_reset_token")
  passwordResetExpires  DateTime? @map("password_reset_expires")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  client                AdminClient? @relation(fields: [clientId], references: [id])
  permissions           AdminUserPermission[]
  sessions              AdminSession[]
  auditLogs             AdminAuditLog[]

  @@index([email])
  @@index([clientId])
  @@index([isActive])
  @@map("admin_users")
}

model AdminUserPermission {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  permission  String
  createdAt   DateTime  @default(now()) @map("created_at")

  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("admin_user_permissions")
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.Text
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model AdminClient {
  id            String   @id @default(cuid())
  name          String
  cnpj          String?  @unique
  databaseSchema String? @map("database_schema") @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  maxUsers      Int?     @map("max_users")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users         AdminUser[]

  @@index([isActive])
  @@map("admin_clients")
}

// ============================================
// CMV - Custo da Mercadoria Vendida
// ============================================

model CmvStoreData {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeSlug String   // 'ahu', 'pilarzinho', 'portao', 'uberaba'
  data      Json     // StoreData JSON (sabores + ingredientes)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, storeSlug])
  @@index([userId])
  @@map("cmv_store_data")
}

// ============================================
// ESTOQUE - Contagem de Estoque
// ============================================

model EstoqueContagem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("em_andamento") // "em_andamento" | "concluida"
  criadoPor   String   @default("Gerente")
  sessoes     Json     // StockCategory[] JSON
  dataCriacao DateTime @default(now()) @map("data_criacao")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("estoque_contagens")
}

// ============================================
// IFOOD - Integração iFood
// ============================================

model IfoodConnection {
  id           String   @id @default(cuid())
  userId       String
  merchantId   String
  merchantName String
  status       String   @default("active") // active | inactive | error
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, merchantId])
  @@index([userId])
  @@map("ifood_connections")
}

model IfoodToken {
  id          String   @id @default(cuid())
  accessToken String   @db.Text
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ifood_tokens")
}

// Permissões de ferramentas para usuários do sistema (stack_users)
model UserToolPermission {
  id          String     @id @default(cuid())
  stackUserId String     @map("stack_user_id")
  tool        String     @db.VarChar(50) // 'etiquetagem', 'checklist', 'cmv', 'analytics', etc.
  isEnabled   Boolean    @default(true) @map("is_enabled")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  stackUser   StackUser  @relation(fields: [stackUserId], references: [id], onDelete: Cascade)

  @@unique([stackUserId, tool])
  @@index([stackUserId])
  @@index([tool])
  @@index([isEnabled])
  @@map("user_tool_permissions")
}
