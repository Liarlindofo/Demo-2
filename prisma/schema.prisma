generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StackUser {
  id                   String        @id @default(uuid())
  primaryEmail         String?       @unique
  displayName          String?
  profileImageUrl      String?
  primaryEmailVerified DateTime?
  lastActiveAt         DateTime?
  userId               String?       @unique
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User?         @relation("StackUserUser", fields: [userId], references: [id], onDelete: Cascade)
  primaryForUser       User?         @relation("UserStackUser")
  whatsappBots         WhatsAppBot[]
  toolPermissions      UserToolPermission[]

  @@index([isActive])
  @@map("stack_users")
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  username     String?       @unique
  password     String?
  fullName     String?
  cnpj         String?
  birthDate    DateTime?
  isAdmin      Boolean       @default(false)
  stackUserId  String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  name         String?
  stackUserRef StackUser?    @relation("StackUserUser")
  stackUser    StackUser?    @relation("UserStackUser", fields: [stackUserId], references: [id])
  stores       Store[]
  apis         UserAPI[]
  botSettings  BotSettings?
  evaluations  Evaluation[]
  checklistDrafts ChecklistDraft[]
  etiquetagemUnidades EtiquetagemUnidade[]
  etiquetagemProdutos EtiquetagemProduto[]
  etiquetagemNomes     EtiquetagemNomeResponsavel[]
  etiquetagemEtiquetas EtiquetagemEtiqueta[]
  cmvStoreData         CmvStoreData[]
  estoqueInsumos       EstoqueInsumo[]
  estoqueContagens     EstoqueContagem[]
  estoqueProdutoConfig EstoqueProdutoConfig[]
  estoqueProdutoOrdem  EstoqueProdutoOrdem?
  ifoodConnections     IfoodConnection[]
  ifoodOrders          IfoodOrder[]
  ifoodFinancialEvents   IfoodFinancialEvent[]
  ifoodSettlements       IfoodSettlement[]
  ifoodCatalogItems      IfoodCatalogItem[]
  ifoodCatalogChangeLogs IfoodCatalogChangeLog[]
  rhLojas                RhLoja[]
  rhCargos               RhCargo[]
  rhFuncionarios         RhFuncionario[]
  rhIaConversas          RhIaConversa[]
  rhHistoricoFuncionarios RhHistoricoFuncionario[]
  rhQuadrosIdeais        RhQuadroIdeal[]
  rhDocumentos           RhDocumentoFuncionario[]
  rhOcorrencias          RhOcorrencia[]
  rhSnapshots            RhSnapshotCustoMensal[]
  rhTransferencias       RhTransferenciaLoja[]
  rhTaxasLoja            RhTaxaLoja[]
  deliveryRiders         DeliveryRider[]
  rhTeamMemberships      RhTeamMember[]
  tarefaTemplates        TarefaTemplate[]
  tarefaGrupos           TarefaGrupo[]
  tarefasAtribuidas      TarefaAtribuida[]
  tarefaSeries           TarefaSerie[]
  reportDefinitions      ReportDefinition[]
  serviceApiKeys         ServiceApiKey[]
  /// Slot WhatsApp usado pelo scheduler de tarefas (digest/pendentes). Null = slot 1.
  tarefasSessionSlot     Int?
  whatsappMessages       WhatsAppMessage[]
  /// Reforço opcional pro prompt de IA (não é filtro rígido). Vazio = critério geral do prompt.
  palavrasChaveReclamacao String[] @default([])
  complaintReviewRuns    ComplaintReviewRun[]
  complaints             Complaint[]
  ifoodComplaintGroups   IFoodComplaintGroup[]

  @@map("users")
}

model UserAPI {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String
  apiKey     String
  baseUrl    String?
  storeId    String
  status     String       @default("disconnected")
  isSyncing  Boolean      @default(false)
  enabled    Boolean      @default(true)
  lastTest   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  salesDaily SalesDaily[]
  syncRuns   SyncRun[]

  @@index([userId])
  @@index([storeId])
  @@index([enabled])
  @@map("user_apis")
}

model Store {
  id                        String        @id @default(cuid())
  name                      String
  address                   String?
  phone                     String?
  cnpj                      String?
  managerName               String?       @map("manager_name")
  abbreviation              String?
  displayOrder              Int?          @default(0) @map("display_order")
  isActive                  Boolean       @default(true)
  lastOvenMaintenance       DateTime?     @map("last_oven_maintenance")
  lastRefrigeratorMaintenance DateTime?   @map("last_refrigerator_maintenance")
  lastPestControl           DateTime?     @map("last_pest_control")
  userId                    String
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations               Evaluation[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([userId])
  @@index([displayOrder])
  @@map("stores")
}

model SalesDaily {
  id              String   @id @default(cuid())
  apiId           String
  storeId         String
  date            DateTime
  totalOrders     Int
  totalSales      Float
  uniqueCustomers Int      @default(0)
  channels        Json?
  createdAt       DateTime @default(now())
  api             UserAPI  @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@unique([apiId, date], name: "sales_daily_api_date_unique")
  @@index([apiId, date])
  @@index([storeId])
  @@map("sales_daily")
}

model Sale {
  id          String   @id @default(cuid())
  userId      String
  storeId     String
  externalId  String
  saleDateUtc DateTime
  totalAmount Float?
  rawJson     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([storeId, externalId], name: "storeId_externalId")
  @@index([storeId])
  @@index([userId])
  @@map("sales")
}

model SalesRawPage {
  id        String   @id @default(cuid())
  syncRunId String
  pageIndex Int
  payload   Json?
  createdAt DateTime @default(now())
  run       SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@map("sales_raw_pages")
}

model SyncRun {
  id               String         @id @default(cuid())
  userApiId        String
  storeId          String
  status           String
  startPeriod      DateTime
  endPeriod        DateTime
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  lastUrl          String?
  totalRequests    Int            @default(0)
  totalRecordsRaw  Int            @default(0)
  totalAfterFilter Int            @default(0)
  syncedCount      Int            @default(0)
  errorsCount      Int            @default(0)
  rawPages         SalesRawPage[]
  errors           SyncError[]
  api              UserAPI        @relation(fields: [userApiId], references: [id], onDelete: Cascade)

  @@index([userApiId])
  @@index([status])
  @@map("sync_runs")
}

model SyncError {
  id             String   @id @default(cuid())
  syncRunId      String
  run            SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  message        String
  payloadPreview String?
  createdAt      DateTime @default(now())

  @@index([syncRunId])
  @@map("sync_errors")
}

model WhatsAppBot {
  id              String     @id @default(cuid())
  userId          String
  stackUser       StackUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot            Int
  status          String?    // Status da sessão (ex: "CONNECTED", "CONNECTING", "QRCODE", etc.)
  isConnected     Boolean    @default(false)
  connectedNumber String?
  sessionJson     Json?      // Estado efêmero (ex: state do WPP). NÃO é fonte de verdade de IA.
  /// Nome amigável da sessão (ex: "Marketing - Ana")
  label           String?
  /// null = nunca configurado (reconnect deve FALHAR, não assumir default).
  /// true = responde com IA; false = somente envio (sem listener / sem resposta).
  iaAtiva         Boolean?
  /// Prompt específico desta sessão (usado quando iaAtiva=true). Nulo se IA desligada.
  iaPrompt        String?    @db.Text
  /// Se true, grava IN/OUT desta sessão em WhatsAppMessage (revisão de reclamações).
  monitorarReclamacoes Boolean @default(false)
  qrCode          String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, slot])
  @@index([userId])
  @@index([isConnected])
  @@index([status])
  @@map("whatsapp_bots")
}

/// Histórico de mensagens WhatsApp por tenant (base para revisão mensal de reclamações).
model WhatsAppMessage {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionSlot       Int
  /// "IN" (cliente) ou "OUT" (bot ou atendente humano)
  direction         String
  /// Número/LID do cliente — agrupa a conversa
  contactId         String
  contactName       String?
  /// "text" | "image" | "audio" | "document" | etc
  messageType       String
  textContent       String?  @db.Text
  /// Path interno no bucket privado whatsapp-evidencias (nunca URL pública).
  mediaUrl          String?
  /// true = humano digitou (não foi resposta automática da IA)
  sentByAgent       Boolean  @default(false)
  /// id original do WPPConnect — evita duplicar em reconexão/replay
  whatsappMessageId String?
  timestamp         DateTime
  /// Preenchido quando a msg entrou num cluster iFood já classificado (cron ou run mensal).
  complaintProcessedAt DateTime?
  createdAt         DateTime @default(now())

  @@index([userId, sessionSlot, timestamp])
  @@index([userId, contactId, timestamp])
  @@index([userId, sessionSlot, whatsappMessageId])
  @@index([userId, contactId, complaintProcessedAt])
  @@map("whatsapp_messages")
}

model BotSettings {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botName       String?  @default("Assistente")
  storeType     String?  @default("restaurant")
  contextLimit  Int      @default(10)
  lineLimit     Int      @default(5)
  basePrompt    String?  @db.Text
  forbidden     String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@map("bot_settings")
}

// Platefull.Check - Catálogo dinâmico de checklist
model ChecklistCategory {
  id       String                  @id @default(cuid())
  nome     String
  ordem    Int
  itens    ChecklistItemTemplate[]
  criadaEm DateTime               @default(now()) @map("criada_em")

  @@index([ordem])
  @@map("checklist_categories")
}

model ChecklistItemTemplate {
  id              String            @id @default(cuid())
  categoriaId     String            @map("categoria_id")
  categoria       ChecklistCategory @relation(fields: [categoriaId], references: [id])
  nome            String
  weight          Int               // restrito a 10, 15 ou 20 — validado no backend
  fotoObrigatoria Boolean           @default(false) @map("foto_obrigatoria")
  ativo           Boolean           @default(true)  // soft-delete: nunca DELETE físico
  ordem           Int
  criadaEm        DateTime          @default(now()) @map("criada_em")
  atualizadaEm    DateTime          @updatedAt @map("atualizada_em")

  @@index([categoriaId])
  @@index([ativo])
  @@index([categoriaId, ativo, ordem])
  @@map("checklist_item_templates")
}

// Platefull.Check Models
model Evaluation {
  id                    String       @id @default(cuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId               String?
  store                 Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName             String
  supervisorName        String       @map("supervisor_name")
  evaluationDate        DateTime     @map("evaluation_date")
  totalScore            Float        @map("total_score")
  maxTotalScore         Float        @map("max_total_score")
  status                String       @default("completed")
  maintenanceList       String?      @db.Text @map("maintenance_list")
  improvementSuggestions String?     @db.Text @map("improvement_suggestions")
  topicScores           TopicScore[]
  itemScores            ItemScore[]
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([storeId])
  @@index([evaluationDate])
  @@map("evaluations")
}

model TopicScore {
  id            String       @id @default(cuid())
  evaluationId  String       @map("evaluation_id")
  evaluation    Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  topicName     String       @map("topic_name")
  topicScore    Float        @map("topic_score")
  maxScore      Float?       @map("max_score")
  observations  String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([evaluationId])
  @@map("topic_scores")
}

model ItemScore {
  id            String       @id @default(cuid())
  evaluationId  String       @map("evaluation_id")
  evaluation    Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  topicName     String       @map("topic_name")
  itemName      String       @map("item_name")
  itemScore     Float        @map("item_score")
  maxScore      Float        @map("max_score")
  status        String       // 'DE ACORDO', 'PARCIAL', 'FORA DO PADRÃO'
  observations  String?       @db.Text
  photoUrls     Json?        @map("photo_urls")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([evaluationId])
  @@map("item_scores")
}

// Platefull.Check - Checklist Drafts (Auto-save)
model ChecklistDraft {
  id                          String   @id @default(cuid())
  userId                      String
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Dados básicos do checklist
  storeId                     String?  @map("store_id")
  storeName                   String   @map("store_name")
  supervisorName              String   @map("supervisor_name")
  evaluationDate              String   @map("evaluation_date")
  
  // Dados do checklist completo (JSON)
  checklistData               Json     @map("checklist_data")
  
  // Metadados para estatísticas
  totalItems                  Int      @default(0) @map("total_items")
  totalPhotos                 Int      @default(0) @map("total_photos")
  totalComments               Int      @default(0) @map("total_comments")
  
  // Controle de versão e limpeza
  lastSaved                   DateTime @default(now()) @map("last_saved")
  createdAt                   DateTime @default(now()) @map("created_at")
  expiresAt                   DateTime @map("expires_at")
  
  @@index([userId])
  @@index([expiresAt])
  @@index([lastSaved])
  @@index([userId, storeId])
  @@map("checklist_drafts")
}

// Platefull.Label - Etiquetagem Models
model EtiquetagemUnidade {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomeExibicao    String   @map("nome_exibicao")
  cnpj            String
  cnpjFormatado   String   @map("cnpj_formatado")
  cidade          String
  codigoInterno   String   @map("codigo_interno")
  isAtivo         Int      @default(1) @map("is_ativo")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  etiquetas       EtiquetagemEtiqueta[]
  nomes           EtiquetagemNomeResponsavel[]

  @@index([userId])
  @@index([isAtivo])
  @@map("etiquetagem_unidades")
}

model EtiquetagemCategoria {
  id                        String   @id @default(cuid())
  nome                      String
  temperaturaArmazenamento  String   @map("temperatura_armazenamento")
  validadeDescongelado      Int?     @map("validade_descongelado")
  validadeResfriado         Int?     @map("validade_resfriado")
  validadePreparado         Int?     @map("validade_preparado")
  validadePorcionado        Int?     @map("validade_porcionado")
  validadeCongeladoMedio    Int?     @map("validade_congelado_medio")
  validadeCongeladoProfundo Int?     @map("validade_congelado_profundo")
  isAtivo                   Int      @default(1) @map("is_ativo")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  produtos                  EtiquetagemProduto[]

  @@index([isAtivo])
  @@map("etiquetagem_categorias")
}

model EtiquetagemProcesso {
  id                  String   @id @default(cuid())
  nome                String
  isRequerRefrigeracao Int      @default(0) @map("is_requer_refrigeracao")
  isAtivo             Int      @default(1) @map("is_ativo")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  etiquetas           EtiquetagemEtiqueta[]

  @@index([isAtivo])
  @@map("etiquetagem_processos")
}

model EtiquetagemProduto {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                    String
  categoriaId             String?  @map("categoria_id")
  categoria               EtiquetagemCategoria? @relation(fields: [categoriaId], references: [id])
  pesoPadrao              Float?   @map("peso_padrao")
  unidadeMedida           String?  @map("unidade_medida")
  marcaFornecedor         String?  @map("marca_fornecedor")
  tipoArmazenamentoPadrao String?  @map("tipo_armazenamento_padrao")
  isAtivo                 Int      @default(1) @map("is_ativo")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  etiquetas               EtiquetagemEtiqueta[]

  @@index([userId])
  @@index([categoriaId])
  @@index([isAtivo])
  @@map("etiquetagem_produtos")
}

model EtiquetagemNomeResponsavel {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unidadeId         String   @map("unidade_id")
  unidade           EtiquetagemUnidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  nomeCompleto      String   @map("nome_completo")
  primeiraUtilizacao DateTime @map("primeira_utilizacao")
  ultimaUtilizacao  DateTime @map("ultima_utilizacao")
  totalUsos         Int      @default(0) @map("total_usos")
  isAtivo           Int      @default(1) @map("is_ativo")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([unidadeId])
  @@index([isAtivo])
  @@map("etiquetagem_nomes_responsaveis")
}

model EtiquetagemEtiqueta {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  produtoId               String   @map("produto_id")
  produto                 EtiquetagemProduto @relation(fields: [produtoId], references: [id])
  unidadeId               String   @map("unidade_id")
  unidade                 EtiquetagemUnidade @relation(fields: [unidadeId], references: [id])
  processoId              String   @map("processo_id")
  processo                EtiquetagemProcesso @relation(fields: [processoId], references: [id])
  dataValidadeOriginal    DateTime? @map("data_validade_original")
  dataHoraManipulacao     DateTime @map("data_hora_manipulacao")
  dataHoraValidade        DateTime @map("data_hora_validade")
  pesoQuantidade          Float    @map("peso_quantidade")
  unidadeMedida           String   @map("unidade_medida")
  responsavelNome         String   @map("responsavel_nome")
  responsavelId           String?  @map("responsavel_id")
  temperaturaArmazenamento String  @map("temperatura_armazenamento")
  codigoEtiqueta           String  @map("codigo_etiqueta")
  marcaFornecedor          String? @map("marca_fornecedor")
  periodoDias              Int?    @map("periodo_dias")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([produtoId])
  @@index([unidadeId])
  @@index([createdAt])
  @@map("etiquetagem_etiquetas")
}

// ============================================
// PAINEL ADMINISTRATIVO - CALENZA ADM
// ============================================

model AdminUser {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String   @map("password_hash")
  name                  String
  role                  String   @default("user") // super_admin, admin, user
  isActive              Boolean  @default(true) @map("is_active")
  clientId              String?  @map("client_id")
  lastLogin             DateTime? @map("last_login")
  passwordResetToken    String?  @map("password_reset_token")
  passwordResetExpires  DateTime? @map("password_reset_expires")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  client                AdminClient? @relation(fields: [clientId], references: [id])
  permissions           AdminUserPermission[]
  sessions              AdminSession[]
  auditLogs             AdminAuditLog[]

  @@index([email])
  @@index([clientId])
  @@index([isActive])
  @@map("admin_users")
}

model AdminUserPermission {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  permission  String
  createdAt   DateTime  @default(now()) @map("created_at")

  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("admin_user_permissions")
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.Text
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model AdminClient {
  id            String   @id @default(cuid())
  name          String
  cnpj          String?  @unique
  databaseSchema String? @map("database_schema") @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  maxUsers      Int?     @map("max_users")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users         AdminUser[]

  @@index([isActive])
  @@map("admin_clients")
}

// ============================================
// CMV - Custo da Mercadoria Vendida
// ============================================

model CmvStoreData {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeSlug String   // 'ahu', 'pilarzinho', 'portao', 'uberaba'
  data      Json     // StoreData JSON (sabores + ingredientes)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, storeSlug])
  @@index([userId])
  @@map("cmv_store_data")
}

// ============================================
// ESTOQUE - Contagem de Estoque
// ============================================

model EstoqueInsumo {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insumoId       String   @map("insumo_id")       // slug identificador (ex: 'farinha-trigo')
  nome           String
  unidade        String   @default("kg")
  categoriaId    String   @map("categoria_id")    // ex: 'materias-primas'
  categoriaNome  String   @map("categoria_nome")
  categoriaIcone String   @map("categoria_icone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, insumoId])
  @@index([userId])
  @@index([userId, categoriaId])
  @@map("estoque_insumos")
}

model EstoqueContagem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("em_andamento") // "em_andamento" | "concluida"
  criadoPor   String   @default("Gerente")
  lojaNome    String?  // nome da loja selecionada no início da contagem
  sessoes     Json     // StockCategory[] JSON
  dataCriacao DateTime @default(now()) @map("data_criacao")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("estoque_contagens")
}

model EstoqueProdutoConfig {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  produtoId     String   @map("produto_id")
  ativo         Boolean  @default(true)
  estoqueMinimo Float?   @map("estoque_minimo")
  modoContagem  String   @default("kg") @map("modo_contagem") // "kg" | "unidade"
  kgPorUnidade  Float?   @map("kg_por_unidade")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, produtoId])
  @@index([userId])
  @@map("estoque_produto_config")
}

model EstoqueProdutoOrdem {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordem     Json     @default("[]") // string[] - array de IDs de produtos
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("estoque_produto_ordem")
}

// ============================================
