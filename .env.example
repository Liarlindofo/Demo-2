# Copie para .env / .env.local e preencha os valores reais.
# Nunca commite chaves reais neste arquivo.

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Stack Auth
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=pck_xxxxxxxx
STACK_SECRET_SERVER_KEY=ssk_xxxxxxxx
DEV_AUTH_BYPASS=true

# Bot WhatsApp — comunicação servidor-servidor (VPS → Plateful)
# Gere um valor aleatório seguro: openssl rand -hex 32
BOT_API_KEY=

# Plateful (Vercel) → VPS WhatsApp (proxy de /api/whatsapp-sessions/*)
# Host PÚBLICO via nginx — NÃO use 127.0.0.1 (no Vercel isso é o serverless)
WHATSAPP_VPS_URL=https://api.platefull.com.br
# Mesmo valor de WHATSAPP_API_KEY na VPS (openssl rand -hex 32)
WHATSAPP_VPS_API_KEY=

# Bot VPS: URL base do Plateful que o bot chama (sem barra final)
PLATEFUL_API_URL=https://app.plateful.com.br

# Validação de fotos por IA (GPT-4o-mini Vision)
OPENAI_API_KEY=

# Supabase Storage — upload de fotos e arquivos de evidência
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
